{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "corelia-landing",
  "compatibility_date": "2026-05-02",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "env": {
    "staging": {
      "name": "corelia-landing-staging"
    }
  }
}
