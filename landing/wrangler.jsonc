{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "corelia-landing",
  // Astro's Cloudflare adapter: prerendered pages are static assets, catalog pages run in the Worker.
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-05-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "corelia-landing-staging"
    }
  }
}
