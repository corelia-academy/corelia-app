---
import { getLangFromUrl, useTranslatedPath } from "@/i18n/utils";
import { useTranslations } from "@/i18n/translations";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Course pages are rendered by this site (catalog), not the learning app.
const coursesUrl = useTranslatedPath(lang)("/courses");

// mock
const courses = [
    {
        image: "/BlockchainBasics.png",
        title: t("roadmap.other.1.title"),
        level: t("roadmap.other.1.level"),
        href: `${coursesUrl}/blockchain-basics`,
    },
    {
        image: "/Soliditydeveloper.png",
        title: t("roadmap.other.2.title"),
        level: t("roadmap.other.2.level"),
        href: `${coursesUrl}/solidity-developer`,
    },
];
---

<div class="w-full border-t border-border">
    <div class="container mx-auto max-w-(--app-max-width) px-3 xl:px-0">
        <div class="border-x border-border">
            <!-- header -->
            <div
                class="flex items-center border-b border-border h-20 py-5 bg-secondary px-10"
            >
                <p
                    class="text-lg leading-[1.15] tracking-[-0.02em] text-foreground md:text-2xl md:leading-[1.2]"
                    style="font-family: var(--font-heading);"
                    data-reveal="text-up"
                >
                    {t("roadmap.other.title")}
                </p>
            </div>

            <!-- courses -->
            <div class="grid grid-cols-1 md:grid-cols-3">
                {
                    courses.map((c, index) => (
                        <a
                            href={c.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group flex flex-col border-r border-border p-5 transition-colors hover:bg-secondary/40"
                            data-reveal="fade-up"
                            data-reveal-delay={index * 150}
                        >
                            <img loading="lazy" decoding="async"
                                src={c.image}
                                alt={c.title}
                                class="aspect-[1200/675] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                            />
                            <div class="flex items-start justify-between gap-3 py-6">
                                <p
                                    class="min-w-0 truncate text-lg leading-[1.15] tracking-[-0.02em] text-foreground md:text-2xl md:leading-[1.2]"
                                    style="font-family: var(--font-heading);"
                                >
                                    {c.title}
                                </p>
                                <span class="shrink-0 border border-[var(--shades-800)] px-2 py-1 text-sm font-medium leading-[1.2] text-[var(--neutral-400)] md:text-lg">
                                    {c.level}
                                </span>
                            </div>
                        </a>
                    ))
                }

                <a
                    href={coursesUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex flex-col p-5 transition-colors hover:bg-secondary/40"
                    data-reveal="fade-up"
                    data-reveal-delay={courses.length * 150}
                >
                    <div class="relative overflow-hidden">
                        <img loading="lazy" decoding="async"
                            src="/SolanaBootcamp.png"
                            alt={t("roadmap.other.viewall.title")}
                            class="aspect-[1200/675] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                        <span
                            class="absolute inset-y-0 right-0 flex w-2/5 flex-col items-center justify-center gap-2 bg-black/65 px-3 text-center text-[#ffffff]"
                        >
                            <span
                                class="text-lg font-medium leading-[1.15] tracking-[-0.02em] md:text-2xl md:leading-[1.2]"
                                style="font-family: var(--font-heading);"
                            >
                                {t("roadmap.other.viewall.badge")}
                            </span>
                            <span
                                aria-hidden="true"
                                class="flex items-center justify-center"
                            >
                                <img loading="lazy" decoding="async"
                                    src="/course-list-play.svg"
                                    alt=""
                                    class="size-10 object-contain"
                                />
                            </span>
                        </span>
                    </div>
                    <div class="flex flex-col gap-1 py-3">
                        <p
                            class="text-base font-medium leading-[1.15] text-foreground md:text-xl md:leading-[1.2]"
                            style="font-family: var(--font-heading);"
                        >
                            {t("roadmap.other.viewall.title")}
                        </p>
                        <p class="text-sm leading-[1.4] text-foreground-subtle md:text-base">
                            {t("roadmap.other.viewall.channel")}
                        </p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
