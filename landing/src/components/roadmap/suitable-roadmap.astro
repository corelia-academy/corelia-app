---

<div class="w-full border-t border-border [overflow-anchor:none]">
    <div class="container mx-auto max-w-(--app-max-width) px-3 xl:px-0 [overflow-anchor:none]">
        <div class="border-x border-border">
            <!-- top -->
            <div
                class="flex items-center border-b border-border h-20 py-5 bg-secondary px-10"
            >
                <p
                    class="text-lg leading-[1.15] tracking-[-0.02em] text-foreground md:text-2xl md:leading-[1.2]"
                    style="font-family: var(--font-heading);"
                    data-reveal="text-up"
                >
                    {t("roadmap.suitable.title")}
                </p>
            </div>
            <div data-reveal="fade-up">
                <SuitableRoadmapCarousel
                    tracks={tracks}
                    forLabel={labels.forLabel}
                    client:visible={{ rootMargin: "200px" }}
                />
            </div>
        </div>
    </div>
</div>

