              stroke="currentColor"
              stroke-width="2"></path>
            <path
              d="M243.148 -293.232L619.799 95.1166"
              stroke="currentColor"
              stroke-width="2"></path>
            <path
              d="M262.529 -312.031L639.18 76.3177"
