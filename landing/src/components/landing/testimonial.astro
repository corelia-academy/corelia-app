      </div>
    </div>
  </div>
</div>
<div class="w-full border-t border-border bg-background">
  <div class="container mx-auto max-w-(--app-max-width) px-3 xl:px-0">
    <div
      class="grid w-full grid-cols-1 overflow-hidden border-x border-border md:grid-cols-2"
    >
      <!-- left banner -->
      <div class="flex items-center border-r border-border p-8 md:p-12"></div>

      <!-- right -->
      <div class="flex flex-col flex-1"></div>
    </div>
  </div>
