---
import { ArrowRightIcon, BrainCircuitIcon, CompassIcon, GraduationCapIcon } from "@lucide/astro";
import { getLangFromUrl, useTranslatedPath } from "@/i18n/utils";
import { getCoraHighlightContent } from "@/components/cora/content";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const content = getCoraHighlightContent(lang);

const appOrigin = String(
  import.meta.env.PUBLIC_APP_URL ?? "/learn",
).replace(/\/$/, "");
const appLoginUrl = `${appOrigin}/login`;
const coraPath = translatePath("/cora");
const icons = [BrainCircuitIcon, GraduationCapIcon, CompassIcon];
const coraLogo = "/logo/Cora_AI_Tutor.svg";
---

<div class="container max-w-[1200px] mx-auto py-16 px-3 xl:px-0 flex flex-col gap-6 items-center justify-center">
  <p
    class="text-foreground text-2xl md:text-3xl lg:text-4xl font-semibold text-center capitalize max-w-[90%] md:max-w-none"
    data-aos="fade-up"
  >
    {content.title}
  </p>
  <p
    class="text-muted-foreground text-xs md:text-sm font-light text-center max-w-[90%] md:max-w-[620px] mx-auto pb-8"
    data-aos="fade-up"
    data-aos-delay="200"
  >
    {content.description}
  </p>

  <div
    class="w-full bg-card border border-border rounded-[40px] p-4 md:p-5 lg:p-6"
    data-aos="fade-up"
    data-aos-delay="300"
  >
    <div class="grid gap-4 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
      <div class="rounded-[28px] bg-secondary p-6 md:p-8 flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1.5 text-xs font-light text-foreground">
            <img loading="lazy" decoding="async" src={coraLogo} alt="Cora AI Tutor" class="h-4 w-auto" />
            {content.badge}
          </div>
          <div class="flex flex-wrap gap-2 pt-5">
            {
              content.pills.map((pill) => (
                <span class="rounded-full border border-border bg-card/70 px-3 py-1.5 text-xs font-light text-muted-foreground">
                  {pill}
                </span>
              ))
            }
          </div>
        </div>

        <div class="pt-8 flex flex-wrap gap-3">
          <a
            href={coraPath}
            class="w-fit bg-primary text-primary-foreground pt-2 pb-2 pl-4 pr-2 rounded-full cursor-pointer hover:bg-secondary hover:text-secondary-foreground transition-all duration-300 text-xs md:text-sm flex items-center justify-center gap-2"
          >
            {content.primaryCta}
            <div class="p-1 bg-primary-foreground/15 rounded-full">
              <ArrowRightIcon class="size-3 text-primary-foreground" />
            </div>
          </a>
          <a
            href={appLoginUrl}
            class="inline-flex items-center justify-center rounded-full border border-border px-4 py-2 text-xs md:text-sm font-medium text-foreground transition-all duration-300 hover:bg-foreground/10"
          >
            {content.secondaryCta}
          </a>
        </div>
      </div>

      <div class="grid gap-3">
        {
          content.cards.map((card, index) => {
            const Icon = icons[index] ?? BrainCircuitIcon;
            return (
              <div
                class="p-4 md:p-5 bg-secondary rounded-[24px]"
                data-aos="fade-left"
                data-aos-delay={450 + index * 100}
              >
                <Icon class="size-6 mb-3 text-primary" />
                <p class="mb-2 text-lg font-medium text-card-foreground">{card.title}</p>
                <p class="text-sm font-light leading-7 text-muted-foreground">{card.description}</p>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</div>
