  @media (min-width: 640px) {
    .ecosystem-partner-grid > :nth-child(even) {
      border-left: 1px solid var(--border);
    }

    .ecosystem-partner-grid > :nth-child(2) {
      border-top: 0;
    }
  }

  @media (min-width: 1024px) {
    .ecosystem-partner-grid > * {
      border-top: 0;
      border-left: 0;
    }

    .ecosystem-partner-grid > :not(:nth-child(4n + 1)) {
      border-left: 1px solid var(--border);
    }

    .ecosystem-partner-grid > :nth-child(n + 5) {
      border-top: 1px solid var(--border);
    }
  } */

  .ecosystem-partner-grid > * {
    border-top: 0;
    border-right: 0;
    border-bottom: 1px solid var(--border);
    border-left: 0;
  }

  /* Mobile: 2 cột */
  @media (max-width: 639px) {
    .ecosystem-partner-grid > :not(:nth-child(2n)) {
      border-right: 1px solid var(--border);
    }
  }

  /* Tablet + Desktop: 4 cột */
  @media (min-width: 640px) {
    .ecosystem-partner-grid > :not(:nth-child(4n)) {
      border-right: 1px solid var(--border);
    }
  }
</style>
