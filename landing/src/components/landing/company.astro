---

<!-- new design -->
<div class="w-full border-t border-border">
  <div
    class="container mx-auto flex flex-col max-w-(--app-max-width) px-3 xl:px-0"
  >
    <div class="flex flex-col border-x border-border">
      <div
        class="bg-secondary relative flex h-20 items-center justify-center px-5 text-lg font-medium leading-[1.15] tracking-[-0.36px] text-foreground md:text-2xl md:leading-[1.2] md:tracking-[-0.48px]"
        style="font-family: var(--font-heading);"
      >
        <p data-reveal="text-up">{t("company.partnerLabel")}</p>
        <Tooltip content={t("company.partnerTooltip")} placement="bottom">
          <button
            type="button"
            class="ml-2 inline-flex size-5 items-center justify-center rounded-full text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            aria-label={t("company.partnerTooltipLabel")}
          >
            <InfoIcon class="size-4" aria-hidden="true" />
          </button>
        </Tooltip>
      </div>
      <div
        class="ecosystem-partner-grid grid grid-cols-2 border-t border-border md:grid-cols-4"
      >
        {
          ecosystemPartners.map((company, index) => (
            <div class="h-36 bg-background p-6">
              <div
                class="flex size-full items-center justify-center"
                data-reveal="fade-up"
                data-reveal-delay={index * 100}
              >
                <img loading="lazy" decoding="async"
                  src={company.logo}
                  alt={company.name}
                  class="object-contain"
                  style={`height: ${company.height}`}
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  /* .ecosystem-partner-grid > :not(:first-child) {
    border-top: 1px solid var(--border);
