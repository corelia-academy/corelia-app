---
import { getLangFromUrl } from "@/i18n/utils";
import { useTranslations } from "@/i18n/translations";
import panelBusinesses from "@/assets/casestudy/Panel_businesses.jpg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const [heroTitleFirstLine, heroTitleSecondLine] =
    t("biz.hero.title").split("\n");
---

<section
    class="relative isolate mt-14 min-h-[280px] overflow-hidden border-b border-border bg-background md:min-h-[240px]"
>
    <img
        src={panelBusinesses.src}
        alt=""
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        class="pointer-events-none absolute inset-0 h-full w-full select-none object-fill"
    />

    <div
        class="container relative z-10 mx-auto flex min-h-[280px] max-w-(--app-max-width) flex-col items-center justify-center gap-4 px-3 py-8 text-center md:min-h-[240px] xl:px-0"
    >
        <p
            class="border border-muted-foreground px-2 py-1 text-sm font-medium leading-[1.2] text-foreground-muted md:text-base"
            data-reveal="fade-up"
        >
            {t("biz.hero.badge")}
        </p>

        <h1
            class="max-w-[920px] text-4xl font-medium leading-[1.15] tracking-[-0.04em] text-foreground md:text-5xl"
            style="font-family: var(--font-heading);"
        >
            <span class="block" data-reveal="text-up" data-reveal-delay="200">
                {heroTitleFirstLine}
            </span>
            <span class="block" data-reveal="text-up" data-reveal-delay="260">
                {heroTitleSecondLine}
            </span>
        </h1>
    </div>
</section>
