---
import { getLangFromUrl } from "@/i18n/utils";
import { useTranslations } from "@/i18n/translations";
import HeroBlogBackground from "@/assets/herocontact.jpg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
    fullScreenFold?: boolean;
}

const { fullScreenFold = false } = Astro.props;
const appOrigin = String(
    import.meta.env.PUBLIC_APP_URL ?? "/learn",
).replace(/\/$/, "");
const appLoginUrl = `${appOrigin}/login`;

const blogBrand = {
    copyright: "@2026",
    statement: "BOUNDARY COME FROM NOTHING",
    name: "CORELIA ACADEMY",
};
---

<section
    class:list={[
        "mt-[var(--site-header-height,0px)] flex flex-col",
        fullScreenFold ? "min-h-0 flex-1" : "md:min-h-[calc(100vh_-_198px)]",
    ]}
>
    <div
        class="mx-auto relative flex w-full flex-1 flex-col overflow-hidden bg-background lg:flex-row"
    >
        <img
            src={HeroBlogBackground.src}
            alt=""
            aria-hidden="true"
            loading="eager"
            fetchpriority="high"
            class="pointer-events-none absolute inset-0 h-full select-none object-fill"
        />
        <div
            class="flex flex-1 flex-col container items-center relative z-10 mx-auto max-w-(--app-max-width) px-3 py-10"
        >
            <p
                class="border border-muted-foreground px-2 py-1 text-sm font-medium leading-[1.2] text-foreground-muted md:text-lg"
                data-reveal="fade-up"
            >
                {t("contact.hero.title")}
            </p>

            <div
                class="flex flex-1 flex-col items-center justify-center gap-6 px-0 lg:px-40 text-center"
            >
                <p
                    class="text-4xl font-medium leading-[1.15] tracking-[-0.04em] text-foreground md:text-5xl"
                    style="font-family: var(--font-heading);"
                >
                    <span data-reveal="text-up" data-reveal-delay="200">
                        {t("contact.hero.description")}
                    </span>
                </p>
                <!-- <div
                    class="flex flex-wrap items-center gap-3"
                    data-reveal="fade-up"
                    data-reveal-delay="1000"
                >
                    <a
                        href={appLoginUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-hover-wave
                        class="h-10 inline-flex cursor-pointer items-center justify-center rounded-lg border border-border-button bg-button-primary-background hover:bg-button-primary-background-hover text-button-primary-foreground px-4 text-sm font-normal leading-[1.2]
                            shadow-button-primary-glow transition-all duration-300 md:text-lg"
                    >
                        <span class="hw-label relative top-px md:top-0">
                            {t("hero.cta.becomeastudent")}
                        </span>
                    </a>
                </div> -->
            </div>
            <div
                class="relative w-full max-w-[240px] text-[10px] leading-[1.2] tracking-[0.04em] shrink-0 p-5 uppercase md:text-xs"
                data-reveal-eager
                data-reveal="fade-up"
                style="font-family: var(--font-number);"
            >
                <span
                    class="absolute right-5 top-5 text-foreground"
                    aria-hidden="true"
                >
                    /
                </span>

                <p
                    class="text-left text-foreground"
                >
                    {blogBrand.copyright}
                </p>

                <p
                    class="text-left mt-2"
                    style="font-family: var(--font-number); color: var(--blue-ribbon-500);"
                >
                    {blogBrand.statement}
                </p>

                <p
                    class="text-right mt-2 text-foreground"
                    
                >
                    {blogBrand.name}
                </p>

                <span
                    class="absolute bottom-5 left-5 text-foreground"
                    aria-hidden="true"
                >
                    /
                </span>
            </div>
        </div>
    </div>
</section>
