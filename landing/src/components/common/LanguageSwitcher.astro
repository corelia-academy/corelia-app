---
import { languages } from "@/i18n/translations";
import { getLangFromUrl, stripLangPrefix, useTranslatedPath } from "@/i18n/utils";
import { cn } from "@/lib/utils";
import { CheckIcon } from "@lucide/astro";

type Props = {
  hrefs?: Partial<Record<keyof typeof languages, string>>;
};

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const { hrefs } = Astro.props as Props;

const basePath = stripLangPrefix(Astro.url.pathname);
const hrefFor = (langCode: keyof typeof languages) =>
  hrefs?.[langCode] ?? translatePath(basePath, langCode);

const languageIcons: Record<string, string> = {
  vi: "/vn.svg",
  en: "/gb.svg",
};
---

<div class="relative">
  <!-- Dropdown for xl and above -->
