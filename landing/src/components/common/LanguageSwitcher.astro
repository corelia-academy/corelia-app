  <!-- cài đặt giao diện mới chọn ngôn ngữ -->
  <div class="hidden xl:flex items-center gap-2 text-base leading-[1.2]" data-nav-group>
    {
      Object.entries(languages).map(([langCode], index) => (
        <>
          {index > 0 && <span class="text-foreground-subtle">|</span>}
          <a
          href={hrefFor(langCode as keyof typeof languages)}
          data-nav-link
          data-nav-active={langCode === lang}
          class="relative inline-block uppercase"
          >
            <span class="font-medium text-foreground-subtle">
              {langCode}
            </span>
            <span
            data-nav-sweep
            class="absolute inset-0 overflow-hidden text-foreground pointer-events-none uppercase"
            aria-hidden="true"
            >
              <span class="absolute inset-0 whitespace-nowrap">{langCode}</span>
            </span>
          </a>
        </>
      ))
    }
  </div>

  <!-- Buttons for below xl -->
  <div class="flex items-center gap-2 xl:hidden">
    {
      Object.entries(languages).map(([langCode, label]) => (
        <a
          href={hrefFor(langCode as keyof typeof languages)}
          class={cn(
            "flex items-center gap-1.5 px-3 py-1.5",
            "rounded-full",
            "text-white text-sm leading-[1.2] no-underline cursor-pointer",
            "transition-all duration-200",
            "hover:bg-white/15 active:bg-white/20",
            "touch-manipulation",
            langCode === lang ? "bg-white/20" : "bg-white/5",
          )}
          aria-label={`Switch to ${label}`}
        >
          <img loading="lazy" decoding="async" src={languageIcons[langCode]} alt={label} class="size-4" />
          <span>{label}</span>
          {langCode === lang && <CheckIcon class="size-4 ml-0.5" />}
        </a>
      ))
    }
  </div>
</div>

