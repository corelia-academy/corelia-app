---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/header.astro";
import Footer from "@/components/common/footer.astro";
import { useTranslations } from "@/i18n/translations";
import { getCollection, type CollectionEntry } from "astro:content";

const t = useTranslations("vi");

type Member = CollectionEntry<"members">;

type Props = {
  member: Member;
  languageHrefs: Record<string, string>;
  alternates?: Partial<Record<"vi" | "en", string>>;
};

export async function getStaticPaths() {
  const members = await getCollection("members");

  return members.map((member) => {
    const viHref = `/vi/member/${member.slug}`;
    const enHref = `/member/${member.slug}`;

    return {
      params: { name: member.slug },
      props: {
        member,
        languageHrefs: { vi: viHref, en: enHref },
        alternates: { vi: viHref, en: enHref },
      },
    };
  });
}

const { member, languageHrefs, alternates } = Astro.props as Props;
const { Content } = await member.render();

const canonicalPath = `/vi/member/${member.slug}`;
const canonicalUrl = `https://corelia.academy${canonicalPath}`;
---

<BaseLayout
  lang="vi"
  title={`${member.data.name} - ${t("meta.title")}`}
  description={member.data.role}
  canonicalUrl={canonicalUrl}
  ogUrl={canonicalUrl}
  ogImage="https://corelia.academy/corelia-og-site-v2-vi.png"
>
  {
    alternates ? (
      <Fragment slot="head">
        {alternates.vi ? (
          <link
            rel="alternate"
            hreflang="vi"
            href={`https://corelia.academy${alternates.vi}`}
          />
        ) : null}
        {alternates.en ? (
          <link
            rel="alternate"
            hreflang="en"
            href={`https://corelia.academy${alternates.en}`}
          />
        ) : null}
      </Fragment>
    ) : null
  }

  <Header languageHrefs={languageHrefs} />

  <main class="min-h-screen px-4 pt-20">
    <div class="container max-w-[900px] mx-auto py-16">
      <header class="space-y-3">
        <div class="flex items-center gap-4">
          {member.data.avatar ? (
            <img
              src={member.data.avatar}
              alt={member.data.name}
              class="size-14 rounded-full object-cover border border-white/10"
              loading="lazy"
            />
          ) : (
            <div class="size-14 rounded-full bg-white/5 border border-white/10" />
          )}
          <div>
            <h1 class="text-3xl md:text-4xl font-semibold leading-tight">
              {member.data.name}
            </h1>
            {member.data.role ? (
              <p class="text-sm text-muted-foreground">{member.data.role}</p>
            ) : null}
          </div>
        </div>

        {member.data.links ? (
          <div class="flex flex-wrap gap-2">
            {member.data.links.website ? (
              <a
                class="text-sm text-primary hover:underline underline-offset-4"
                href={member.data.links.website}
                target="_blank"
                rel="noreferrer"
              >
                Website
              </a>
            ) : null}
            {member.data.links.github ? (
              <a
                class="text-sm text-primary hover:underline underline-offset-4"
                href={member.data.links.github}
                target="_blank"
                rel="noreferrer"
              >
                GitHub
              </a>
            ) : null}
            {member.data.links.x ? (
              <a
                class="text-sm text-primary hover:underline underline-offset-4"
                href={member.data.links.x}
                target="_blank"
                rel="noreferrer"
              >
                X
              </a>
            ) : null}
            {member.data.links.linkedin ? (
              <a
                class="text-sm text-primary hover:underline underline-offset-4"
                href={member.data.links.linkedin}
                target="_blank"
                rel="noreferrer"
              >
                LinkedIn
              </a>
            ) : null}
          </div>
        ) : null}
      </header>

      <article
        class="mt-10 space-y-6 leading-relaxed text-base
        [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:mt-10
        [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-8
        [&_p]:text-muted-foreground [&_p]:leading-relaxed
        [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:text-muted-foreground
        [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:text-muted-foreground
        [&_a]:text-primary [&_a:hover]:underline [&_a]:underline-offset-4
        [&_code]:bg-white/10 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded-md
        [&_pre]:bg-black/30 [&_pre]:border [&_pre]:border-white/10 [&_pre]:rounded-xl [&_pre]:p-4 [&_pre]:overflow-x-auto"
      >
        <Content />
      </article>
    </div>
  </main>

  <Footer />
</BaseLayout>
