---
import BlogNewsRoute from "@/components/blog/blog-news-route.astro";
import { getBlogPosts } from "@/lib/blog";
import { loadBlogPage } from "@/lib/blogRoute";

export const prerender = false;

const posts = await loadBlogPage(Astro, () => getBlogPosts("vi"));
if (posts instanceof Response) return posts;
