---
import ArticleDetail from "@/components/blog/ArticleDetail.astro";
import { getArticle } from "@/lib/blog";
import { loadBlogPage } from "@/lib/blogRoute";

export const prerender = false;

const article = await loadBlogPage(Astro, () => getArticle("en", "case-study", Astro.params.slug));
if (article instanceof Response) return article;
---

<ArticleDetail {...article} />
