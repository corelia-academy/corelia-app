---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/header.astro";
import Footer from "@/components/common/footer.astro";
import BlogPostCard from "@/components/blog/BlogPostCard.astro";
import { useTranslations } from "@/i18n/translations";
import { getCollection } from "astro:content";
import {
  blogCategoryUrl,
  blogIndexUrl,
  getBlogFacetPage,
} from "@/lib/blog";
import { loadBlogPage } from "@/lib/blogRoute";
import { blogCategoryLabel, type BlogCategory } from "@/lib/blogTaxonomy";

const t = useTranslations("en");

export const prerender = false;

const listing = await loadBlogPage(Astro, () => getBlogFacetPage("en", "category", Astro.params.category, Astro.params.page));
if (listing instanceof Response) return listing;
const { posts, page, totalPages } = listing;
const category = listing.key as BlogCategory;
const fmtDate = new Intl.DateTimeFormat("en-US", { dateStyle: "medium" });

const members = await getCollection("members");
const memberBySlug = new Map(members.map((m) => [m.slug, m] as const));

const canonicalPath = blogCategoryUrl("en", category, page);
const canonicalUrl = `https://corelia.academy${canonicalPath}`;
---

<BaseLayout
  lang="en"
  title={`${blogCategoryLabel("en", category)} - ${t("blog.title")}`}
  description={t("blog.description")}
  canonicalUrl={canonicalUrl}
  ogUrl={canonicalUrl}
  ogImage="https://corelia.academy/corelia-og-site-v2-en.png"
>
  <Fragment slot="head">
    <link
      rel="alternate"
      hreflang="vi"
      href={`https://corelia.academy${blogCategoryUrl("vi", category, page)}`}
    />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
  </Fragment>

  <Header />

  <main class="min-h-screen px-4 pt-20">
    <div class="container max-w-[1200px] mx-auto py-16">
      <div class="space-y-3">
        <p class="text-sm text-muted-foreground">
          <a
            class="text-primary hover:underline underline-offset-4"
            href={blogIndexUrl("en")}
          >
            ← {t("blog.title")}
          </a>
        </p>
        <h1 class="text-3xl md:text-4xl font-semibold text-foreground">
          {blogCategoryLabel("en", category)}
        </h1>
        <p class="text-lg text-muted-foreground max-w-[700px]">
          {t("blog.description")}
        </p>
      </div>

      <section class="mt-10 grid gap-4 md:grid-cols-2">
        {
          posts.map((post) => (
            <BlogPostCard
              locale="en"
              post={post}
              fmtDate={fmtDate}
              memberBySlug={memberBySlug}
              byText={t("blog.by")}
            />
          ))
        }
      </section>

      <nav class="mt-10 flex items-center justify-between gap-4">
        <a
          class="text-sm text-primary hover:underline underline-offset-4"
          href={blogCategoryUrl("en", category, page - 1)}
        >
          ← Previous
        </a>
        <span class="text-sm text-muted-foreground">
          Page {page}/{totalPages}
        </span>
        {
          page < totalPages ? (
            <a
              class="text-sm text-primary hover:underline underline-offset-4"
              href={blogCategoryUrl("en", category, page + 1)}
            >
              Next →
            </a>
          ) : (
            <span class="w-[74px]" />
          )
        }
      </nav>
    </div>
  </main>

  <Footer />
</BaseLayout>
