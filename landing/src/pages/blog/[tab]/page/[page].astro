---
import BlogNewsRoute from "@/components/blog/blog-news-route.astro";
import { getBlogNewsPage } from "@/lib/blog";
import { loadBlogPage } from "@/lib/blogRoute";

export const prerender = false;

const { tab, page } = Astro.params;
// "all" is paginated at /blog/page/N, not /blog/all/page/N.
const route = await loadBlogPage(Astro, async () => (tab === "all" ? null : getBlogNewsPage("en", tab, page)));
if (route instanceof Response) return route;
---

<BlogNewsRoute lang="en" tabPath={route.tab} page={route.page} />
