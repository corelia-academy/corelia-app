---
import Header from "../components/common/header.astro";
import Footer from "../components/common/footer.astro";
import HeroBackground from "@/assets/herocontact.jpg";
import { getLangFromUrl, useTranslatedPath } from "@/i18n/utils";
import { useTranslations } from "@/i18n/translations";
import BaseLayout from "@/layouts/BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout
  lang={lang}
  title={t("404.title")}
  description={t("404.description")}
  robots="noindex, nofollow"
>
  <div class="flex min-h-svh flex-col">
    <Header />

    <main class="mt-[var(--site-header-height,0px)] flex min-h-0 flex-1 flex-col">
      <div class="relative mx-auto flex w-full flex-1 flex-col overflow-hidden bg-background">
        <img
          src={HeroBackground.src}
          alt=""
          aria-hidden="true"
          loading="eager"
          class="pointer-events-none absolute inset-0 size-full select-none object-fill"
        />
        <div
          class="container relative z-10 mx-auto flex max-w-(--app-max-width) flex-1 flex-col items-center px-3 py-10"
        >
          <p
            class="border border-muted-foreground px-2 py-1 text-sm font-medium leading-[1.2] text-foreground-muted md:text-lg"
            style="font-family: var(--font-number);"
            data-reveal="fade-up"
          >
            404
          </p>

          <div
            class="flex flex-1 flex-col items-center justify-center gap-6 py-10 text-center lg:px-40"
          >
            <h1
              class="text-4xl font-medium leading-[1.15] tracking-[-0.04em] text-foreground md:text-5xl"
              style="font-family: var(--font-heading);"
            >
              <span data-reveal="text-up" data-reveal-delay="200">
                {t("404.heading")}
              </span>
            </h1>
            <p
              class="max-w-[560px] text-sm font-normal leading-[1.4] text-foreground-muted md:text-base"
              data-reveal="text-up"
              data-reveal-delay="600"
            >
              {t("404.description")}
            </p>
            <div
              class="flex flex-wrap items-center justify-center gap-3 pt-2"
              data-reveal="fade-up"
              data-reveal-delay="1000"
            >
              <a
                href={translatePath("/")}
                data-hover-wave
                class="inline-flex h-10 cursor-pointer items-center justify-center rounded-lg border border-border-button bg-button-primary-background px-4 text-sm font-normal leading-[1.2] text-button-primary-foreground shadow-button-primary-glow transition-all duration-300 hover:bg-button-primary-background-hover md:text-lg"
              >
                <span class="hw-label relative top-px md:top-0">
                  {t("404.backHome")}
                </span>
              </a>
              <a
                href={translatePath("/contact")}
                data-hover-wave
                class="inline-flex h-10 cursor-pointer items-center justify-center rounded-lg border border-border-container bg-primary-container px-4 text-sm font-normal leading-[1.2] text-on-primary-container shadow-button-tertiary-glow transition-all duration-300 hover:bg-primary-container-hover md:text-lg"
              >
                <span class="hw-label relative top-px md:top-0">
                  {t("404.contact")}
                </span>
              </a>
            </div>
          </div>

          <div
            class="relative w-full max-w-[240px] shrink-0 p-5 text-[10px] uppercase leading-[1.2] tracking-[0.04em] md:text-xs"
            style="font-family: var(--font-number);"
            aria-hidden="true"
            data-reveal-eager
            data-reveal="fade-up"
          >
            <span class="absolute right-5 top-5 text-foreground">/</span>
            <p class="text-left text-foreground">@2026</p>
            <p class="mt-2 text-left" style="color: var(--blue-ribbon-500);">
              BOUNDARY COME FROM NOTHING
            </p>
            <p class="mt-2 text-right text-foreground">CORELIA ACADEMY</p>
            <span class="absolute bottom-5 left-5 text-foreground">/</span>
          </div>
        </div>
      </div>
    </main>
  </div>

  <Footer />
</BaseLayout>
