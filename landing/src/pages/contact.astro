//     name: "X (Twitter)",
//     invert: true,
//   },
//   {
//     icon: "/youtube-fill-logo.svg",
//     link: "https://www.youtube.com/@coreliaacademy",
//     name: "YouTube",
//     invert: false,
//   },
//   {
//     icon: "/facebook-fill-logo.svg",
//     link: "https://www.facebook.com/",
