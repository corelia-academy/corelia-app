{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corelia-app",
  "compatibility_date": "2026-05-02",
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "corelia-staging"
    }
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
