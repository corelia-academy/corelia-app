---
import type { BlogPost, BlogLocale } from "@/lib/blog";
import { blogPostUrl } from "@/lib/blog";
import type { CollectionEntry } from "astro:content";
import BlogBadges from "@/components/blog/BlogBadges.astro";
import BlogMedia from "@/components/blog/BlogMedia.astro";

type Member = CollectionEntry<"members">;

type Props = {
  locale: BlogLocale;
  post: BlogPost;
  fmtDate: Intl.DateTimeFormat;
  memberBySlug: Map<string, Member>;
  byText: string;
};

const { locale, post, fmtDate, memberBySlug, byText } = Astro.props as Props;

const author = post.data.author ? memberBySlug.get(post.data.author) : null;
const authorName = author?.data.name ?? post.data.author;
const authorHref = post.data.author ? `/member/${post.data.author}` : null;
const href = blogPostUrl(locale, post.slug);
---

<article
  class="border border-border rounded-2xl p-6 bg-background/30 hover:bg-background/40 transition-colors"
  data-reveal="fade-up"
>
  <BlogMedia
    media={post.data.media}
    title={post.data.title}
    href={href}
    mode="card"
    class="mb-4"
  />

  <div class="flex items-center justify-between gap-4">
    <div class="flex items-center gap-2 flex-wrap">
      <p class="text-xs text-muted-foreground">
        {fmtDate.format(post.data.date)}
      </p>
      {
        authorHref ? (
          <p class="text-xs text-muted-foreground">
            <span class="mx-1">•</span>
            {byText}{" "}
            <a
              class="text-primary hover:underline underline-offset-4"
              href={authorHref}
            >
              {authorName}
            </a>
          </p>
        ) : null
      }
    </div>
    <BlogBadges
      locale={locale}
      category={post.data.category}
      tags={post.data.tags}
      maxTags={3}
    />
  </div>

  <h2 class="mt-3 text-xl font-semibold leading-snug">
    <a class="hover:underline underline-offset-4" href={href}>
      {post.data.title}
    </a>
  </h2>

  {
    post.data.description ? (
      <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
        {post.data.description}
      </p>
    ) : null
  }
</article>
