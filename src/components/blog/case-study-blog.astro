---
import { getLangFromUrl } from "@/i18n/utils";
import { useTranslations } from "@/i18n/translations";
import { blogPostUrl, getBlogPosts, type BlogLocale } from "@/lib/blog";
import { blogCategoryLabel } from "@/lib/blogTaxonomy";
import { getYouTubeThumbnailUrl } from "@/lib/youtube";
import StripeBand from "../common/StripeBand.astro";

const lang = getLangFromUrl(Astro.url) as BlogLocale;
const t = useTranslations(lang);

const posts = await getBlogPosts(lang);

const additionalCaseStudyKeys = [
    "sui-learning-tour-huit-2026",
    "corelia-academy-uef-strategic-mou-fit-career-day-2026",
    "corelia-stellar-apac-hackathon-vietnam-demo-day-2026",
    "corelia-unihackfest-da-nang-campus-2026",
] as const;

function getPreviewImage(post: (typeof posts)[number]) {
    const media = post.data.media;

    if (!media) return null;

    if (media.type === "image") {
        return media.src;
    }

    return getYouTubeThumbnailUrl(media.url);
}

function estimateReadMinutes(post: (typeof posts)[number]) {
    const wordCount =
        post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;

    return Math.max(1, Math.ceil(wordCount / 200));
}

function readTimeLabel(minutes: number) {
    return lang === "en" ? `${minutes} min read` : `Đọc trong ${minutes} phút`;
}

const postsByTranslationKey = new Map(
    posts.map((post) => [post.data.translationKey, post]),
);

const blogCards = additionalCaseStudyKeys.flatMap((translationKey) => {
    const post = postsByTranslationKey.get(translationKey);

    if (!post) return [];

    return [
        {
            title: post.data.title,
            description: post.data.description ?? "",
            category: blogCategoryLabel(lang, post.data.category),
            tagCount: Math.max(post.data.tags.length - 1, 0),
            moreTagsLabel: t("casestudies.card.moreTags"),
            readTime: estimateReadMinutes(post),
            href: blogPostUrl(lang, post.slug),
            image: getPreviewImage(post),
        },
    ];
});

const featuredCard = blogCards[0];
const secondaryCards = blogCards.slice(1);
---

{
    blogCards.map((card) =>
        card.image ? <link rel="preload" as="image" href={card.image} /> : null,
    )
}

<section class="w-full border-t border-border">
    <div class="container mx-auto max-w-(--app-max-width) px-3 xl:px-0">
