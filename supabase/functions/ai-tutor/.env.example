# Local dev only:
# supabase functions serve ai-tutor --env-file supabase/functions/ai-tutor/.env

# Core
CORELIA_SUPABASE_URL=http://127.0.0.1:54321
CORELIA_SUPABASE_SECRET_KEYS=sb_secret_xxx
CORELIA_CORS_ALLOWED_ORIGINS=http://localhost:5173
CORELIA_APP_ORIGIN=http://localhost:5173

# Provider selection
# Supported: stub | openai | anthropic
CORELIA_AI_PROVIDER=stub

# OpenAI
OPENAI_API_KEY=
CORELIA_OPENAI_DEFAULT_MODEL=gpt-5-mini
CORELIA_OPENAI_COMPLEX_MODEL=gpt-5-mini

# Anthropic
ANTHROPIC_API_KEY=
CORELIA_ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest
CORELIA_ANTHROPIC_COMPLEX_MODEL=claude-sonnet-4-5
