# Copy → .env và điền giá trị. Dùng với:
#   supabase functions serve corelia-api --env-file supabase/functions/corelia-api/.env
#
# Local: lấy SUPABASE_URL + keys từ `supabase status` (sau supabase start).

# -----------------------------------------------------------------------------
# Bắt buộc để function boot (createServiceClient)
# -----------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
# Chuẩn mới: JSON dictionary of secret keys (ưu tiên key "default")
SUPABASE_SECRET_KEYS={"default":"your-secret-key-from-supabase-status"}
# Legacy fallback (deprecated) — chỉ dùng nếu không set SUPABASE_SECRET_KEYS
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# SePay — payments.sepay.checkout | verify | ipn | payments.transactions
# -----------------------------------------------------------------------------
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# IPN webhook: nên set riêng; nếu trống code fallback sang SEPAY_SECRET_KEY
SEPAY_IPN_SECRET=
# sandbox | production (mặc định sandbox)
SEPAY_ENV=sandbox
# true → dùng PG API sandbox (trừ khi override SEPAY_PGAPI_BASE_URL)
SEPAY_SANDBOX=true
# SEPAY_PGAPI_BASE_URL=https://pgapi-sandbox.sepay.vn

# -----------------------------------------------------------------------------
# Open Campus VC issuer — credentials.checkCourseCompletion | grant | mint
# Thiếu key → mint failed với lỗi cấu hình (không crash boot).
# -----------------------------------------------------------------------------
OPENCAMPUS_API_KEY_STAGING=
OPENCAMPUS_API_KEY_MAINNET=
# Fallback nếu chỉ có một key cho cả hai môi trường
OPENCAMPUS_API_KEY=

# -----------------------------------------------------------------------------
# Resend — mail giao dịch (hackathons.notifyRegistrationReview, v.v.)
# Thiếu RESEND_API_KEY hoặc MAIL_FROM → gửi mail bị skip, không crash.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Địa chỉ đã verify trên Resend, ví dụ: Corelia <noreply@yourdomain.com>
MAIL_FROM=
# URL app (không slash cuối) — link trong email, ví dụ: https://app.corelia.example
CORELIA_APP_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Google Meet — chỉ khi dùng meetApiFetch (chưa gắn route mặc định)
# PRIVATE_KEY: một dòng, dùng \n cho xuống dòng trong PEM
# -----------------------------------------------------------------------------
# GOOGLE_MEET_CLIENT_EMAIL=xxx@xxx.iam.gserviceaccount.com
# GOOGLE_MEET_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
# GOOGLE_MEET_DELEGATED_USER=user@yourdomain.com
