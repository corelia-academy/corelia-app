# Local dev only:
# cp supabase/functions/.env.example supabase/functions/.env
# supabase functions serve <function-name> --env-file supabase/functions/.env
# Optional hosted sync: supabase secrets set --env-file supabase/functions/.env

# Core Supabase
CORELIA_SUPABASE_URL=http://127.0.0.1:54321
CORELIA_SUPABASE_SECRET_KEYS=sb_secret_xxx

# CORS / app origin
CORELIA_CORS_ALLOWED_ORIGINS=http://localhost:5173
CORELIA_PAYMENT_CALLBACK_ORIGINS=http://localhost:5173
CORELIA_APP_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# AI provider / OpenAI
# Supported: openai
CORELIA_AI_PROVIDER=openai
OPENAI_API_KEY=
CORELIA_OPENAI_DEFAULT_MODEL=gpt-4o-mini
CORELIA_OPENAI_COMPLEX_MODEL=gpt-4o
CORELIA_OPENAI_DESCRIPTION_MODEL=gpt-4o-mini
CORELIA_OPENAI_QUESTIONS_MODEL=gpt-4o-mini
CORELIA_OPENAI_SUMMARY_MODEL=gpt-4o-mini

# Payments / SePay
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET=
SEPAY_ENV=sandbox
SEPAY_API_TOKEN=
SEPAY_USERAPI_BASE_URL=
SEPAY_BANK_ACCOUNT_ID=

# Mail / Resend
RESEND_API_KEY=
MAIL_FROM=

# Open Campus
OPENCAMPUS_API_KEY_STAGING=
OPENCAMPUS_API_KEY_MAINNET=
OPENCAMPUS_API_KEY=
