# Local dev only:
# cp supabase/functions/.env.example supabase/functions/.env
# supabase functions serve <function-name> --env-file supabase/functions/.env
# Optional hosted sync: supabase secrets set --env-file supabase/functions/.env

# Core Supabase variables are injected automatically by the Edge runtime:
# SUPABASE_URL and SUPABASE_SECRET_KEYS.

# CORS / app origin
CORELIA_CORS_ALLOWED_ORIGINS=http://localhost:5173
CORELIA_APP_ORIGIN=http://localhost:5173
# Path prefix of the SPA on CORELIA_APP_ORIGIN (Vite base); the landing site owns the root.
CORELIA_APP_BASE_PATH=/learn
APP_URL=http://localhost:5173/learn
OG_PROXY_SECRET=

# AI provider / OpenAI
# Learner AI model config is retired; model overrides are retained only for instructor-facing generators.
# The server-side key is also used by project moderation and optional Jobs classification.
# Set these as local/hosted secrets; never commit real values.
# OPENAI_API_KEY=
# CORELIA_OPENAI_DESCRIPTION_MODEL=
# CORELIA_OPENAI_QUESTIONS_MODEL=
# Project moderation uses omni-moderation-latest and gpt-5.4-mini.
# Jobs classification is optional: without OPENAI_API_KEY, new jobs enter the
# review queue after deterministic classification instead of being published.
CORELIA_JOBS_CLASSIFIER_MODEL=gpt-5.4-mini
CORELIA_JOBS_CRON_SECRET=
CORELIA_JOBS_ALERT_WEBHOOK_URL=
WEB3_CAREER_API_TOKEN=
CRYPTOJOBS_LIST_API_KEY=

# Mail / Resend
RESEND_API_KEY=
MAIL_FROM=
RESEND_WEBHOOK_SIGNING_SECRET=
EMAIL_WORKER_SECRET=

# Open Campus
OCID_CLIENT_ID=
# Must match VITE_OCID_SANDBOX for this deployment.
OCID_SANDBOX=false
OPENCAMPUS_API_KEY_STAGING=
OPENCAMPUS_API_KEY_MAINNET=
OPENCAMPUS_API_KEY=

# Corelia Studio course generation
# One OpenAI key per agent, in flow order, separate from OPENAI_API_KEY so Studio usage and
# billing never share the app key and are tracked per agent. Code steps need no key.
# A2 Course Research covers both the brief and the research step.
# CORELIA_STUDIO_A1_CATALOG_RESEARCH_OPENAI_API_KEY=
# CORELIA_STUDIO_A2_COURSE_RESEARCH_OPENAI_API_KEY=
# CORELIA_STUDIO_A3_CURRICULUM_OPENAI_API_KEY=
# CORELIA_STUDIO_A4_CURRICULUM_REVIEW_OPENAI_API_KEY=
# CORELIA_STUDIO_A5_LESSON_OPENAI_API_KEY=
# CORELIA_STUDIO_A6_LESSON_REVIEW_OPENAI_API_KEY=
# Shared with the scheduler that calls op studio.tick (header x-corelia-studio-cron-secret).
CORELIA_STUDIO_CRON_SECRET=
