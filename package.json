{
  "name": "corelia-app",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "functions:serve": "supabase functions serve corelia-api --env-file supabase/functions/.env",
    "functions:serve:ai": "supabase functions serve ai-tutor --env-file supabase/functions/.env",
    "functions:serve:generate-description": "supabase functions serve generate-description --env-file supabase/functions/.env",
    "functions:deploy": "supabase functions deploy corelia-api",
    "dev:staging": "vite --mode staging",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "build:staging": "tsc -b && vite build --mode staging",
    "build:prod": "tsc -b && vite build --mode production",
    "lint": "eslint .",
    "cora:test:stream": "node scripts/test-cora-ai-stream.mjs",
    "cora:seed:knowledge": "node scripts/seed-knowledge.mjs",
    "test": "vitest run",
    "preview": "pnpm run build && wrangler dev",
    "deploy:dev": "pnpm build:dev",
    "deploy:staging": "pnpm build:staging",
    "deploy:prod": "pnpm build:prod",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/google-sans": "^5.2.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@opencampus/ocid-connect-js": "^2.0.8",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.86.2",
    "@tailwindcss/vite": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.0.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.4",
    "react-markdown": "^10.1.0",
    "react-router": "^7.13.1",
    "react-router-dom": "^7.13.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.35.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "shadcn": "^4.0.2",
    "supabase": "^2.98.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "3.2.4",
    "wrangler": "^4.87.0"
  }
}
