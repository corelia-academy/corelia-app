{
  "name": "corelia-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:dev": "pnpm build && firebase deploy --project dev",
    "deploy:staging": "pnpm build:staging && firebase deploy --project staging",
    "deploy:prod": "pnpm build && firebase deploy --project prod",
    "deploy:functions:dev": "firebase deploy --only functions --project dev",
    "deploy:functions:staging": "firebase deploy --only functions --project staging",
    "deploy:functions:prod": "firebase deploy --only functions --project prod",
    "deploy:hosting:dev": "pnpm build && firebase deploy --only hosting --project dev",
    "deploy:hosting:staging": "pnpm build:staging && firebase deploy --only hosting --project staging",
    "deploy:hosting:prod": "pnpm build && firebase deploy --only hosting --project prod"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/google-sans": "^5.2.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@opencampus/ocid-connect-js": "^2.0.8",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.10.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.13.1",
    "react-router-dom": "^7.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "shadcn": "^4.0.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
